{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ehsbha/api-contracts": ["../../packages/api-contracts/src/index.ts"],
      "@ehsbha/api-contracts/*": ["../../packages/api-contracts/src/*"],
      "@ehsbha/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@ehsbha/shared-types/*": ["../../packages/shared-types/src/*"],
      "@ehsbha/ui-tokens": ["../../packages/ui-tokens/src/index.ts"],
      "@ehsbha/ui-tokens/*": ["../../packages/ui-tokens/src/*"]
    }
  },
  "include": ["src"]
}

# Test Environment Configuration
# Copy this file to .env.test and fill in the values.
# Never use production credentials here.

NODE_ENV=test

# PostgreSQL - use a disposable database with ehsbha_test_ prefix
DATABASE_URL=postgresql://user:password@localhost:5432/ehsbha_test_placeholder

# Driver JWT secret (non-production)
JWT_DRIVER_SECRET=test-driver-secret-not-for-production

# Admin JWT secret (non-production)
JWT_ADMIN_SECRET=test-admin-secret-not-for-production

# OCR substitute mode (no live Azure calls)
OCR_SUBSTITUTE_MODE=true

# Mail substitute mode (no live mail delivery)
MAIL_SUBSTITUTE_MODE=true

# API port for integration tests
API_PORT=4001
SMOKE_PORT=4002
SMOKE_DRIVER_PHONE=+201000000001
SMOKE_DRIVER_PASSWORD=<test-driver-password>
ADMIN_SEED_PASSWORD=<test-admin-password>

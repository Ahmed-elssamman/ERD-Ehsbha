# Test Environment Configuration
# Copy this file to .env.test when you need a dedicated Neon-backed test environment.
# Never use production credentials here.

NODE_ENV=test

# Dedicated Neon test database:
# - Use a disposable database or branch whose database name starts with ehsbha_test_
# - DATABASE_URL must use the pooled "-pooler" host
# - DIRECT_URL must use the direct host (no "-pooler")
DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@TEST-ENDPOINT-pooler.REGION.aws.neon.tech/ehsbha_test_placeholder?sslmode=require&connect_timeout=15
DIRECT_URL=postgresql://TEST_USER:TEST_PASSWORD@TEST-ENDPOINT.REGION.aws.neon.tech/ehsbha_test_placeholder?sslmode=require&connect_timeout=15

# Driver JWT secrets (non-production)
JWT_ACCESS_SECRET=test-driver-access-secret-not-for-production-please-change
JWT_REFRESH_SECRET=test-driver-refresh-secret-not-for-production-please-change
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Admin JWT secrets (non-production)
ADMIN_JWT_ACCESS_SECRET=test-admin-access-secret-not-for-production-please-change
ADMIN_JWT_REFRESH_SECRET=test-admin-refresh-secret-not-for-production-please-change
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_JWT_REFRESH_TTL=8h

# OCR substitute mode (no live Gemini calls)
OCR_SUBSTITUTE_MODE=true

# Mail substitute mode (no live mail delivery)
MAIL_SUBSTITUTE_MODE=true

# API ports for integration/smoke tests
API_PORT=4001
SMOKE_PORT=4002
SMOKE_DRIVER_PHONE=+201000000001
SMOKE_DRIVER_PASSWORD=<test-driver-password>
ADMIN_SEED_PASSWORD=<test-admin-password>

GEMINI_API_KEY=test-gemini-key-not-for-production
GEMINI_MODEL=gemini-3.5-flash

// ─── Community ──────────────────────────────────────────────────────────────

enum CommunityCategory {
  BEST_APPS
  EXPERIENCE_UBER
  EXPERIENCE_INDRIVE
  EXPERIENCE_DIDI
  EXPERIENCE_OTHER
  FUEL_SAVING
  BEST_HOURS
  MAINTENANCE_ADVICE
  EFFICIENCY_TIPS
  OPERATIONAL_MISTAKES
  WEEKLY_LESSON
  SAFETY_ADVICE
  GENERAL
}

enum ReactionKind {
  LIKE
  DISLIKE
}

model CommunityPost {
  id            String            @id @default(cuid())
  driverId      String            @map("driver_id")
  category      CommunityCategory
  title         String
  body          String
  likeCount     Int               @default(0) @map("like_count")
  dislikeCount  Int               @default(0) @map("dislike_count")
  trendingScore Float             @default(0) @map("trending_score")
  isHidden      Boolean           @default(false) @map("is_hidden")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  driver    Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  reactions CommunityReaction[]

  @@index([category, createdAt(sort: Desc)])
  @@index([driverId, createdAt(sort: Desc)])
  @@index([trendingScore(sort: Desc)])
  @@index([likeCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("community_posts")
}

model CommunityReaction {
  postId    String       @map("post_id")
  driverId  String       @map("driver_id")
  kind      ReactionKind
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  driver Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@id([postId, driverId])
  @@index([driverId])
  @@map("community_reactions")
}

// ─── Platform reviews ───────────────────────────────────────────────────────

model PlatformReview {
  id         String   @id @default(cuid())
  driverId   String   @unique @map("driver_id")
  rating     Int
  title      String?
  body       String
  isFeatured Boolean  @default(false) @map("is_featured")
  isApproved Boolean  @default(true) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([isApproved, createdAt(sort: Desc)])
  @@index([isFeatured, isApproved, rating(sort: Desc)])
  @@index([rating(sort: Desc), createdAt(sort: Desc)])
  @@map("platform_reviews")
}

// ─── Support tickets ────────────────────────────────────────────────────────

enum TicketCategory {
  BUG
  FEATURE_REQUEST
  IMPROVEMENT
  QUESTION
  OTHER
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  PLANNED
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  category  TicketCategory
  subject   String
  body      String
  status    TicketStatus   @default(OPEN)
  adminNote String?        @map("admin_note")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("support_tickets")
}

// ─── Admin platform ─────────────────────────────────────────────────────────

model AdminUser {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String   @map("password_hash")
  displayName         String   @map("display_name")
  isActive            Boolean  @default(true) @map("is_active")
  permissionsVersion  Int      @default(1) @map("permissions_version")
  mfaEnabled          Boolean  @default(false) @map("mfa_enabled")
  mfaSecret           String?  @map("mfa_secret")
  lastLoginAt         DateTime? @map("last_login_at")
  lastLoginIp         String?  @map("last_login_ip")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdById         String?  @map("created_by_id")

  createdBy     AdminUser?      @relation("AdminCreatedBy", fields: [createdById], references: [id])
  created       AdminUser[]     @relation("AdminCreatedBy")
  roleLinks     AdminUserRole[]
  refreshTokens AdminRefreshToken[]
  auditLogs     AdminAuditLog[] @relation("AdminAuditActor")
  alertsResolved AdminAlert[]   @relation("AdminAlertResolver")

  @@index([email])
  @@index([isActive])
  @@map("admin_users")
}

model AdminRole {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissionLinks AdminRolePermission[]
  userLinks       AdminUserRole[]

  @@map("admin_roles")
}

model AdminPermission {
  id          Int    @id @default(autoincrement())
  scope       String
  action      String
  description String?

  roleLinks AdminRolePermission[]

  @@unique([scope, action])
  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String @map("role_id")
  permissionId Int    @map("permission_id")

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUserRole {
  adminUserId String   @map("admin_user_id")
  roleId      String   @map("role_id")
  grantedAt   DateTime @default(now()) @map("granted_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

model AdminRefreshToken {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  userAgent   String?   @map("user_agent")
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_refresh_tokens")
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  actorAdminId  String   @map("actor_admin_id")
  actorRole     String   @map("actor_role")
  action        String
  targetType    String   @map("target_type")
  targetId      String   @map("target_id")
  before        Json?
  after         Json?
  reason        String?
  reasonCode    String?  @map("reason_code")
  ip            String?
  userAgent     String?  @map("user_agent")
  requestId     String?  @map("request_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  actor AdminUser @relation("AdminAuditActor", fields: [actorAdminId], references: [id])

  @@index([targetType, targetId, occurredAt(sort: Desc)])
  @@index([actorAdminId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model AdminAlert {
  id          String    @id @default(cuid())
  code        String
  severity    String
  title       String
  body        String
  payload     Json?
  readBy      Json      @default("[]") @map("read_by")
  resolvedAt  DateTime? @map("resolved_at")
  resolvedById String?  @map("resolved_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  resolvedBy AdminUser? @relation("AdminAlertResolver", fields: [resolvedById], references: [id])

  @@index([severity, createdAt(sort: Desc)])
  @@index([code, createdAt(sort: Desc)])
  @@map("admin_alerts")
}

model BlocklistedIdentifier {
  id          String   @id @default(cuid())
  kind        String   // 'phone' | 'email' | 'device'
  value       String
  reason      String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([kind, value])
  @@map("blocklisted_identifiers")
}

model AdminSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  RETRYABLE_FAILURE
}

model IdempotencyRecord {
  id             String            @id @default(cuid())
  realm          String
  actorId        String            @map("actor_id")
  operationId    String            @map("operation_id")
  key            String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  resourceType   String?           @map("resource_type")
  resourceId     String?           @map("resource_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  completedAt    DateTime?         @map("completed_at")
  expiresAt      DateTime          @map("expires_at")

  @@unique([realm, actorId, operationId, key])
  @@index([expiresAt])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("idempotency_records")
}

model TripRevision {
  id String @id @default(cuid())
  driverId String @map("driver_id")
  recordId String @map("record_id")
  version Int
  action TripRevisionAction
  actor TripRevisionActor
  before Json?
  after Json
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')")) @map("created_at")
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  record Trip @relation(fields: [recordId], references: [id], onDelete: Cascade)
  @@unique([recordId, version])
  @@index([driverId, recordId, version(sort: Desc)])
  @@map("trip_revisions")
}

enum ReportPeriod {
  WEEKLY
  MONTHLY
}

model DriverReport {
  id String @id @default(cuid())
  driverId String @map("driver_id")
  period ReportPeriod
  startsOn DateTime @db.Date @map("starts_on")
  endsOn DateTime @db.Date @map("ends_on")
  version Int @default(1)
  content Json
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  capturedAt DateTime @db.Timestamptz(3) @map("captured_at")
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  revisions ReportRevision[]
  @@unique([driverId, period, startsOn])
  @@unique([driverId, id])
  @@index([driverId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("driver_reports")
}

model ReportRevision {
  id String @id @default(cuid())
  driverId String @map("driver_id")
  reportId String @map("report_id")
  version Int
  content Json
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  report DriverReport @relation(fields: [driverId, reportId], references: [driverId, id], onDelete: Cascade, map: "report_revisions_report_owner_fkey")
  @@unique([reportId, version])
  @@index([driverId, reportId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("report_revisions")
}

model ReportPreferences {
  driverId String @id @map("driver_id")
  weeklyEnabled Boolean @default(true) @map("weekly_enabled")
  monthlyEnabled Boolean @default(true) @map("monthly_enabled")
  deliveryMinute Int @default(540) @map("delivery_minute")
  quietEnabled Boolean @default(true) @map("quiet_enabled")
  quietStartMinute Int @default(1380) @map("quiet_start_minute")
  quietEndMinute Int @default(420) @map("quiet_end_minute")
  version Int @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3) @map("updated_at")
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  @@map("report_preferences")
}

{
  "name": "ehsbha",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm --workspace @ehsbha/api run start:dev",
    "api:build": "npm --workspace @ehsbha/api run build",
    "api:test": "npm --workspace @ehsbha/api run test",
    "api:typecheck": "npm --workspace @ehsbha/api run typecheck",
    "api:prisma:generate": "npm --workspace @ehsbha/api run prisma:generate",
    "api:prisma:migrate": "npm --workspace @ehsbha/api run prisma:migrate",
    "api:seed": "npm --workspace @ehsbha/api run seed",
    "web:dev": "npm --workspace @ehsbha/web run dev",
    "web:build": "npm --workspace @ehsbha/web run build",
    "web:preview": "npm --workspace @ehsbha/web run preview",
    "web:typecheck": "npm --workspace @ehsbha/web run typecheck",
    "admin:dev": "npm --workspace @ehsbha/admin run dev",
    "admin:build": "npm --workspace @ehsbha/admin run build",
    "admin:preview": "npm --workspace @ehsbha/admin run preview",
    "admin:typecheck": "npm --workspace @ehsbha/admin run typecheck",
    "dev": "npm-run-all -p api:dev web:dev",
    "dev:admin": "npm-run-all -p api:dev admin:dev",
    "dev:all": "npm-run-all -p api:dev web:dev admin:dev",
    "build": "npm run api:build && npm run web:build && npm run admin:build",
    "typecheck": "npm run api:typecheck && npm run web:typecheck && npm run admin:typecheck"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
